[Unit]
Description=PoC10 $10 paper reliability bot
After=network-online.target
[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu
EnvironmentFile=/home/ubuntu/quarki.env
ExecStart=/home/ubuntu/quarki-venv/bin/python poc10_bot.py
Restart=always
RestartSec=30
MemoryMax=150M
[Install]
WantedBy=multi-user.target
