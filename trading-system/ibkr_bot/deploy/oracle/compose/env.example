# Copy to .env beside docker-compose.yml on the Oracle VM. chmod 600.
# These ARE the live-account credentials — never check into git.

TWS_USERID=YOUR_IBKR_USERNAME
TWS_PASSWORD=YOUR_IBKR_PASSWORD

# live = account U24971994 (real money). paper = practice.
TRADING_MODE=live

# Leave blank to use the IB Key mobile push default. Other options
# documented at https://github.com/gnzsnz/ib-gateway-docker
TWOFA_DEVICE=

# Random password for VNC. Set anything you want; only used when you
# tunnel to debug the container's GUI.
VNC_PASSWORD=changeme-vnc-not-trading
