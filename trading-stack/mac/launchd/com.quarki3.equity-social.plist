<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key><string>com.quarki3.equity-social</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>-c</string>
		<string>set -a; source ~/quarki.env 2>/dev/null; source ~/ntfy.env 2>/dev/null; set +a; P=/opt/homebrew/bin/python3.10; S=/Users/quarki3/equity_social/equity_social.py; $P $S --leg x_fetch; $P $S --leg collect; exec $P $S --leg grade</string>
	</array>
	<key>StandardOutPath</key><string>/Users/quarki3/trading-data/logs/equity-social.log</string>
	<key>StandardErrorPath</key><string>/Users/quarki3/trading-data/logs/equity-social.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key><string>/Users/quarki3</string>
		<key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<key>StartCalendarInterval</key>
	<dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>35</integer></dict>
</dict>
</plist>
