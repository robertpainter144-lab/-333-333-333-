[Unit]
Description=IBKR Bot — equity_logger (per-minute equity + positions snapshot)
Wants=docker.service
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/ibkr_bot
EnvironmentFile=/home/ubuntu/ibkr_bot/runtime.env
ExecStart=/home/ubuntu/ibkr_bot/venv/bin/python /home/ubuntu/ibkr_bot/equity_logger.py --daemon
Restart=on-failure
RestartSec=15
StandardOutput=append:/var/log/ibkr_equity.log
StandardError=append:/var/log/ibkr_equity.err

[Install]
WantedBy=multi-user.target
