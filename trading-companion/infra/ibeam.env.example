# See https://github.com/Voyz/ibeam#environment-variables for the full list.
# IBEAM_ACCOUNT and IBEAM_PASSWORD belong to the family member's IBKR login.
# Keep this file off git; the .gitignore covers infra/*.env.

IBEAM_ACCOUNT=replace-me
IBEAM_PASSWORD=replace-me

# Paper trading by default.
IBEAM_GATEWAY_BASE_URL=https://localhost:5000
IBEAM_INPUTS_DIR=/srv/inputs
IBEAM_OUTPUTS_DIR=/srv/outputs

# 2FA: see ibeam docs (SMS, IBKR Mobile push, etc.)
